# Signaling config (JSON string, baked into build by Vite)
# Leave empty for BroadcastChannel (local testing).
VITE_APP_CONFIG='{"driver":null,"iceServers":[],"iceTransportPolicy":"all"}'

# Example: MQTT driver
# VITE_APP_CONFIG='{"driver":{"type":"mqtt","module":"peerix/mqtt","server":"wss://broker.emqx.io:8084/mqtt","prefix":"peerix/"},"iceServers":[{"urls":["stun:stun.l.google.com:19302"]}],"iceTransportPolicy":"all"}'

# Example: NATS driver
# VITE_APP_CONFIG='{"driver":{"type":"nats","module":"peerix/nats","servers":["wss://demo.nats.io:8443"],"prefix":"peerix."},"iceServers":[{"urls":["stun:stun.l.google.com:19302"]}],"iceTransportPolicy":"all"}'

# Example: SSE (Mercure) driver
# VITE_APP_CONFIG='{"driver":{"type":"sse","url":"http://localhost:8080/.well-known/mercure","publisherJwtKey":"eyJhbGciOiJIUzI1NiJ9.eyJtZXJjdXJlIjp7InB1Ymxpc2giOlsiKiJdLCJzdWJzY3JpYmUiOlsiKiJdfX0.bVXdlWXwfw9ySx7-iV5OpUSHo34RkjUdVzDLBcc6l_g"},"iceServers":[{"urls":["stun:stun.l.google.com:19302"]}],"iceTransportPolicy":"all"}'
